# Copy to .env and fill in only what you need. Never commit real values.

# Server
FLOWMAP_PORT=3920
CHROME_PATH=

# Optional logged-in screenshots (UI dialog overrides these)
FLOWMAP_LOGIN_EMAIL=
FLOWMAP_LOGIN_PASSWORD=

# Project-specific login fallbacks
FLOWMAP_FAMILYTREE_EMAIL=
FLOWMAP_FAMILYTREE_PASSWORD=
FLOWMAP_PLANE_EMAIL=
FLOWMAP_PLANE_PASSWORD=
FLOWMAP_PLANE_URL=
FLOWMAP_PLANE_SLUG=
FLOWMAP_PLANE_PROJECT_ID=
FLOWMAP_GHOST_EMAIL=
FLOWMAP_GHOST_PASSWORD=

# Google Analytics (or choose the desktop client JSON in the UI)
FLOWMAP_GOOGLE_CLIENT_ID=
FLOWMAP_GOOGLE_CLIENT_SECRET=

# Designer Preflight
PREFLIGHT_DIR=
PREFLIGHT_BIN=

# Cursor agent via SDK (optional; CLI works without this)
CURSOR_API_KEY=
FLOWMAP_CURSOR_MODEL=
